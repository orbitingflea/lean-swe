import Fuzz.Common.Rng
import LeanSwe.LinuxSyscall.Passwd.Types

namespace Fuzz.Passwd

open Fuzz.Common
open LeanSwe.LinuxSyscall.Passwd

/-- Operation variant generated by the `Passwd` fuzzer. -/
inductive PasswdFuzzKind where
  /-- Call `getpwuid uid`. -/
  | getpwuid
  /-- Call `getpwnam name`. -/
  | getpwnam
  deriving Repr, DecidableEq, BEq, Inhabited

/-- One generated fuzz step for `LeanSwe.LinuxSyscall.Passwd`. -/
structure PasswdFuzzOp where
  /-- Lookup operation variant (`getpwuid` or `getpwnam`). -/
  kind : PasswdFuzzKind
  /-- Numeric UID passed to `getpwuid`. -/
  uid : UInt32
  /-- Raw username bytes passed to `getpwnam`. -/
  name : ByteArray
  deriving DecidableEq, BEq, Inhabited

instance : Repr PasswdFuzzOp where
  reprPrec op _ :=
    s!"\{ kind := {repr op.kind}, uid := {op.uid}, name := " ++ formatPasswdBytes op.name ++ " }"

/-- Human-readable label for a `PasswdFuzzOp` operation family. -/
def PasswdFuzzOp.opName (op : PasswdFuzzOp) : String :=
  match op.kind with
  | .getpwuid => "getpwuid"
  | .getpwnam => "getpwnam"

/-- Convert ASCII text to `ByteArray` for curated fuzzer inputs. -/
def asciiName (s : String) : ByteArray :=
  ByteArray.mk (s.toList.map (fun c => UInt8.ofNat c.toNat)).toArray

/-- Curated edge-case UIDs including current user, `root`, `1`, `nobody`, `0x80000000`, and high-bit UIDs. -/
def curatedUids (curUid : UInt32) : Array UInt32 :=
  #[curUid, 0, 1, 65534, 0x7FFFFFFF, 0x80000000, 0xFFFFFFFE, 0xFFFFFFFF]

/-- Curated usernames covering valid accounts, missing names, empty `""`, embedded NULs, non-UTF-8 bytes, delimiters, and `65536`/`65537`/`1048576`/`1048577`-byte NUL-free names. -/
def curatedNames (curName : ByteArray) : Array ByteArray :=
  #[ curName
   , asciiName "root"
   , asciiName "nobody"
   , ByteArray.empty
   , asciiName "no_such_user_xyz_99999"
   , ByteArray.mk #[0]
   , ByteArray.mk #[0, 97]
   , ByteArray.mk #[97, 0]
   , ByteArray.mk #[114, 111, 111, 116, 0, 120]
   , ByteArray.mk #[0xFF, 0xFE]
   , ByteArray.mk #[0x80, 0x41]
   , ByteArray.mk #[0xC3, 0x28]
   , ByteArray.mk #[58, 10]
   , ByteArray.mk #[47, 58, 13, 10]
   , ByteArray.mk (Array.replicate 65536 (UInt8.ofNat 'a'.toNat))
   , ByteArray.mk (Array.replicate 65537 (UInt8.ofNat 'a'.toNat))
   , ByteArray.mk (Array.replicate MAX_PASSWD_NAME_BYTES (UInt8.ofNat 'a'.toNat))
   , ByteArray.mk (Array.replicate (MAX_PASSWD_NAME_BYTES + 1) (UInt8.ofNat 'a'.toNat)) ]

/-- Generate one pseudo-random `PasswdFuzzOp` biased toward curated boundary UIDs and usernames, including random non-UTF-8 and NUL bytes. -/
def genPasswdFuzzOp (curUid : UInt32) (curName : ByteArray) (r : Rng) : PasswdFuzzOp × Rng :=
  let (useUid, r1) := r.nextBool
  if useUid then
    let (useCurated, r2) := r1.chance 3 4
    let (uid, r3) :=
      if useCurated then
        r2.choose (curatedUids curUid) curUid
      else
        let (small, r2a) := r2.nextBool
        if small then
          let (n, r2b) := r2a.nextRange 0 70000
          (UInt32.ofNat n, r2b)
        else
          r2a.nextU32
    ({ kind := .getpwuid, uid := uid, name := ByteArray.empty }, r3)
  else
    let (useCurated, r2) := r1.chance 3 4
    let (name, r3) :=
      if useCurated then
        r2.choose (curatedNames curName) curName
      else
        let (rawBytes, r2a) := r2.chance 1 3
        let (len, r2b) := r2a.nextRange 0 24
        let (bytes, r2c) := Id.run do
          let mut curR := r2b
          let mut arr := ByteArray.emptyWithCapacity len
          for _ in List.range len do
            if rawBytes then
              let (b, nextR) := curR.nextRange 0 255
              arr := arr.push (UInt8.ofNat b)
              curR := nextR
            else
              let (b, nextR) := curR.nextRange 97 122
              arr := arr.push (UInt8.ofNat b)
              curR := nextR
          return (arr, curR)
        (bytes, r2c)
    ({ kind := .getpwnam, uid := curUid, name := name }, r3)

private def pushUniqueOp (acc : List PasswdFuzzOp) (cand : PasswdFuzzOp) : List PasswdFuzzOp :=
  if acc.contains cand then acc else acc ++ [cand]

/-- Shrink a `PasswdFuzzOp` strictly monotonically toward `.getpwuid`, smaller `uid`, and shorter `name` using binary-search jumps. -/
def shrinkPasswdFuzzOp (curUid : UInt32) (op : PasswdFuzzOp) : List PasswdFuzzOp :=
  match op.kind with
  | .getpwuid =>
    let binaryUids : List UInt32 := Id.run do
      let mut out : List UInt32 := [0, 1, curUid, 65534, op.uid / 2]
      for shift in List.range 32 do
        let step : UInt32 := (1 : UInt32) <<< UInt32.ofNat (31 - shift)
        if step ≤ op.uid then
          out := out ++ [op.uid - step]
      return out
    let rawUids := binaryUids.filter (· < op.uid)
    rawUids.foldl (fun acc u => pushUniqueOp acc { op with uid := u }) []
  | .getpwnam =>
    let base : List PasswdFuzzOp :=
      [ { kind := .getpwuid, uid := 0, name := ByteArray.empty }
      , { kind := .getpwuid, uid := curUid, name := ByteArray.empty } ]
    let withNul :=
      if !validPasswdName op.name && op.name.size > 1 then
        base ++ [{ op with name := ByteArray.mk #[0] }]
      else
        base
    let n := op.name.size
    let shorter : List PasswdFuzzOp := Id.run do
      if n == 0 then
        return []
      if n == 1 then
        return [{ op with name := ByteArray.empty }]
      let mut out : List PasswdFuzzOp :=
        [ { op with name := ByteArray.empty }
        , { op with name := op.name.extract 0 1 }
        , { op with name := op.name.extract (n - 1) n }
        , { op with name := op.name.extract 0 (n / 2) }
        , { op with name := op.name.extract (n / 2) n } ]
      let mut d := 1
      let mut pows : List Nat := []
      while d < n do
        pows := d :: pows
        d := d * 2
      for step in pows do
        out := out ++
          [ { op with name := op.name.extract 0 (n - step) }
          , { op with name := op.name.extract step n } ]
        if step < n then
          out := out ++
            [ { op with name := op.name.extract 0 1 ++ op.name.extract (1 + step) n }
            , { op with name := op.name.extract 0 (n - 1 - step) ++ op.name.extract (n - 1) n } ]
          let midStart := (n - step) / 2
          out := out ++
            [ { op with name := op.name.extract 0 midStart ++ op.name.extract (midStart + step) n } ]
      return out
    (withNul ++ shorter).foldl (fun acc c => if c != op then pushUniqueOp acc c else acc) []

/-- Deterministic boundary corpus exercised in `--smoke` and at the start of fuzz runs. -/
def smokeCorpus (curUid : UInt32) (curName : ByteArray) : Array PasswdFuzzOp := Id.run do
  let mut ops : Array PasswdFuzzOp := #[]
  for u in curatedUids curUid do
    ops := ops.push { kind := .getpwuid, uid := u, name := ByteArray.empty }
  for n in curatedNames curName do
    ops := ops.push { kind := .getpwnam, uid := curUid, name := n }
  return ops

end Fuzz.Passwd
