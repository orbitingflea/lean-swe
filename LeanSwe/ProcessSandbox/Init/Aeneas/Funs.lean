def ops.run_init
  (s : init_sys.Sys) (argc : Std.Usize) :
  Result (Std.I32 × init_sys.Sys)
  := do
  let (cm, s1) ← cli.parse_cli s argc
  match cm with
  | cli.CliMode.Probe => ok (0#i32, s1)
  | cli.CliMode.Run f =>
    let s2 ← ops.set_cloexec_if_valid s1 f.plan_fd
    let s3 ← ops.set_cloexec_if_valid s2 f.status_fd
    let s4 ← ops.set_cloexec_if_valid s3 f.go_fd
    let s5 ← ops.set_cloexec_if_valid s4 f.ctrl_fd
    let r ← cli.validate_cli_fds f
    match r with
    | core.result.Result.Ok f1 =>
      let (r1, s6) ← ops.read_plan_fd s5 f1.plan_fd
      match r1 with
      | core.result.Result.Ok b =>
        let (_, s7) ← init_sys.close_fd s6 f1.plan_fd
        let (r2, s8, _) ← ops.setup_sandbox_from_plan s7 b f1.ctrl_fd
        match r2 with
        | core.result.Result.Ok pair =>
          let (exec_tbl, envc) := pair
          let s9 ← init_sys.plan_buf_free s8 b
          let s10 ←
            ops.send_status s9 f1.status_fd ops.PS_STATUS_READY 0#u8 0#i32
          let (b1, s11) ← ops.wait_for_go_byte s10 f1.go_fd
          if b1
          then
            let (r3, s12) ← init_sys.pipe2_cloexec s11
            match r3 with
            | core.result.Result.Ok p =>
              let (err_r, err_w) := p
              let (r4, s13) ← init_sys.fork_proc s12
              match r4 with
              | core.result.Result.Ok child_pid =>
                match child_pid with
                | 0#iscalar =>
                  let s14 ←
                    ops.run_guest_child s13 err_r err_w f1.status_fd exec_tbl
                      envc
                  ok (127#i32, s14)
                | _ =>
                  ops.supervise_child s13 child_pid err_r err_w f1.status_fd
              | core.result.Result.Err e =>
                let (_, s14) ← init_sys.close_fd s13 err_r
                let (_, s15) ← init_sys.close_fd s14 err_w
                let s16 ←
                  ops.send_status s15 f1.status_fd ops.PS_STATUS_INIT_ERR 0#u8
                    e
                ok (1#i32, s16)
            | core.result.Result.Err e =>
              let s13 ←
                ops.send_status s12 f1.status_fd ops.PS_STATUS_INIT_ERR 0#u8 e
              ok (1#i32, s13)
          else
            let (_, s12) ← init_sys.close_fd s11 f1.status_fd
            ok (0#i32, s12)
        | core.result.Result.Err e =>
          let s9 ← init_sys.plan_buf_free s8 b
          let s10 ←
            ops.send_status s9 f1.status_fd ops.PS_STATUS_INIT_ERR 0#u8 e
          ok (1#i32, s10)
      | core.result.Result.Err e =>
        let (_, s7) ← init_sys.close_fd s6 f1.plan_fd
        let s8 ←
          ops.send_status s7 f1.status_fd ops.PS_STATUS_INIT_ERR 0#u8 e
        ok (1#i32, s8)
    | core.result.Result.Err e =>
      let s6 ← ops.send_status s5 f.status_fd ops.PS_STATUS_INIT_ERR 0#u8 e
      ok (1#i32, s6)

