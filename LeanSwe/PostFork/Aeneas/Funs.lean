def child.run_child_post_sync
  (s : sys.Sys) (fds : child.ChildFds) (keep_fds : Slice Std.I32)
  (exec : child.ExecSpec) :
  Result sys.Sys
  := do
  let i ← lift (fds.flags &&& child.FLAG_REDIRECT_STDIO)
  let i1 ← lift (fds.flags &&& child.FLAG_CLOSE_UNKEPT_ABOVE2)
  let i2 ← lift (fds.flags &&& child.FLAG_CLOSE_STDIO_SOURCES)
  let (r, s1) ← child.prepare_rep_w s (i != 0#u32) fds.rep_w
  match r with
  | core.result.Result.Ok fd =>
    let (r1, s2) ←
      child.apply_redir_stdio s1 (i != 0#u32) fds.stdin_fd fds.stdout_fd
        fds.stderr_fd (i2 != 0#u32)
    match r1 with
    | core.result.Result.Ok _ =>
      let (r2, s3) ← fd_ops.clear_cloexec_slice s2 keep_fds
      match r2 with
      | core.result.Result.Ok _ =>
        let (r3, s4) ← child.apply_close_unkept s3 (i1 != 0#u32) fd keep_fds
        match r3 with
        | core.result.Result.Ok _ =>
          match exec.cwd with
          | none =>
            let (e, s5) ← sys.execve s4 exec.path exec.argv exec.envp
            child.report_and_exit s5 fd child.STAGE_EXECVE e child.ENOENT
          | some dir =>
            let (r4, s5) ← sys.chdir s4 dir
            match r4 with
            | core.result.Result.Ok _ =>
              let (e, s6) ← sys.execve s5 exec.path exec.argv exec.envp
              child.report_and_exit s6 fd child.STAGE_EXECVE e child.ENOENT
            | core.result.Result.Err e =>
              child.report_and_exit s5 fd child.STAGE_CHDIR e fd_ops.EIO
        | core.result.Result.Err e =>
          child.report_and_exit s4 fd child.STAGE_CLOSE_UNKEPT e fd_ops.EIO
      | core.result.Result.Err e =>
        child.report_and_exit s3 fd child.STAGE_FD_SETUP e fd_ops.EIO
    | core.result.Result.Err e =>
      child.report_and_exit s2 fd child.STAGE_FD_SETUP e fd_ops.EIO
  | core.result.Result.Err e =>
    child.report_and_exit s1 fds.rep_w child.STAGE_FD_SETUP e fd_ops.EIO

/-- [postfork::child::run_child]:
    Source: 'src/child.rs', lines 492:0-503:1
