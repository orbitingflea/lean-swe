private def buggySuffixesApi (base : FsApi) : FsApi :=
  { base with suffixes := fun _ => #[] }

private def stubStat (kind : EntryKind) : FileStat :=
  { kind := kind
    byteSize := 0
    mode := 0o755
    modifiedSec := 0
    modifiedNsec := 0
    accessedSec := 0
    accessedNsec := 0 }

